<odoo>
    <!-- Vistas para Tarifas de Demora -->
    <record id="view_demurrage_rate_tree" model="ir.ui.view">
        <field name="name">demurrage.rate.tree</field>
        <field name="model">demurrage.rate</field>
        <field name="arch" type="xml">
            <tree string="Shipping Rates">
                <field name="shipping_line_id"/>
                <field name="container_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="free_days"/>
            </tree>
        </field>
    </record>

    <record id="view_demurrage_rate_form" model="ir.ui.view">
        <field name="name">demurrage.rate.form</field>
        <field name="model">demurrage.rate</field>
        <field name="arch" type="xml">
            <form string="Shipping Rate Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="shipping_line_id"/>
                            <field name="container_type"/>
                            <field name="free_days"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rate Tiers">
                            <field name="tier_ids">
                                <tree editable="bottom">
                                    <field name="day_start"/>
                                    <field name="day_end"/>
                                    <field name="daily_rate_usd"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vistas para Bill of Lading (BL) -->
    <record id="view_demurrage_bl_tree" model="ir.ui.view">
        <field name="name">demurrage.bl.tree</field>
        <field name="model">demurrage.bl</field>
        <field name="arch" type="xml">
            <tree string="Bills of Lading">
                <field name="name"/>
                <field name="client_id"/>
                <field name="shipping_line_id"/>
                <field name="discharge_date"/>
            </tree>
        </field>
    </record>

    <record id="view_demurrage_bl_form" model="ir.ui.view">
        <field name="name">demurrage.bl.form</field>
        <field name="model">demurrage.bl</field>
        <field name="arch" type="xml">
            <form string="Bill of Lading">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="client_id"/>
                        </group>
                        <group>
                            <field name="shipping_line_id"/>
                            <field name="discharge_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Containers">
                            <field name="container_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="container_type"/>
                                    <field name="discharge_date"/>
                                    <field name="return_date"/>
                                    <field name="days_out"/>
                                    <field name="free_days"/>
                                    <field name="demurrage_days"/>
                                    <field name="shipping_cost_usd"/>
                                    <field name="client_cost_usd"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acciones y Menús Principales -->
    <record id="action_demurrage_rate" model="ir.actions.act_window">
        <field name="name">Shipping Rates</field>
        <field name="res_model">demurrage.rate</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_demurrage_bl" model="ir.actions.act_window">
        <field name="name">Bills of Lading</field>
        <field name="res_model">demurrage.bl</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_demurrage_root" name="Demurrage Control" sequence="10"/>
    <menuitem id="menu_demurrage_operations" name="Operations" parent="menu_demurrage_root" sequence="10"/>
    <menuitem id="menu_demurrage_bl" name="Bills of Lading" parent="menu_demurrage_operations" action="action_demurrage_bl" sequence="10"/>
    <menuitem id="menu_demurrage_configuration" name="Configuration" parent="menu_demurrage_root" sequence="20"/>
    <menuitem id="menu_demurrage_rate" name="Shipping Rates" parent="menu_demurrage_configuration" action="action_demurrage_rate" sequence="10"/>
</odoo>